---
import Logo from './Logo.astro';
import { LANGS, LANG_LABEL, HTML_LANG, localePath, useT, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useT(lang);
const link = (p: string) => localePath(lang, p);

const nav = [
  { href: '/services', label: t.nav.services },
  { href: '/about', label: t.nav.about },
  { href: '/news', label: t.nav.news },
  { href: '/contact', label: t.nav.contact },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={link('/')} aria-label={`Northgo ${t.nav.home}`}><Logo /></a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-icon" aria-hidden="true"></span>
      <span>{t.nav.menu}</span>
    </button>

    <div class="nav-panel" id="site-nav">
      <nav aria-label={t.nav.menu}>
        <ul class="nav-list">
          {nav.map((item) => (
            <li>
              <a href={link(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <details class="lang">
        <summary aria-label={t.nav.language}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 6h-2.9a15.7 15.7 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8ZM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4ZM4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3Zm.8 2h2.9c.3 1.3.8 2.5 1.4 3.6A8 8 0 0 1 5.1 16ZM8 8H5.1a8 8 0 0 1 4.3-3.6C8.8 5.5 8.4 6.7 8 8Zm4 12c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4Zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4Zm.3 5.6c.6-1.1 1.1-2.3 1.4-3.6h2.9a8 8 0 0 1-4.3 3.6Zm1.7-5.6a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4Z"/></svg>
          <span>{LANG_LABEL[lang]}</span>
        </summary>
        <ul>
          {LANGS.map((l) => (
            <li>
              <a href={localePath(l, path)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-current={l === lang ? 'true' : undefined}>
                {LANG_LABEL[l]}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <a class="btn btn--primary quote" href={link('/contact#quote')}>{t.nav.quote}</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const header = document.querySelector('.site-header');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-open', open);
  });

  const lang = document.querySelector<HTMLDetailsElement>('.lang');
  document.addEventListener('click', (e) => {
    if (lang?.open && !lang.contains(e.target as Node)) lang.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lang?.open) {
      lang.open = false;
      lang.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 1.5rem; min-height: 72px; }
  .brand { flex: none; }

  .nav-panel { display: flex; align-items: center; gap: 1.25rem; margin-left: auto; }
  .nav-list { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav-list a {
    display: block; padding: 0.5rem 0.8rem; border-radius: 8px;
    color: var(--navy); font-weight: 600; text-decoration: none;
  }
  .nav-list a:hover { background: var(--sky); }
  .nav-list a[aria-current='page'] { color: var(--blue); box-shadow: inset 0 -2px 0 var(--blue); border-radius: 0; }

  .lang { position: relative; }
  .lang summary {
    display: flex; align-items: center; gap: 0.4rem; cursor: pointer; list-style: none;
    padding: 0.45rem 0.7rem; border: 1px solid var(--line); border-radius: 999px;
    color: var(--navy); font-size: 0.9rem; font-weight: 600;
  }
  .lang summary::-webkit-details-marker { display: none; }
  .lang ul {
    position: absolute; right: 0; top: calc(100% + 0.4rem); min-width: 10rem;
    list-style: none; margin: 0; padding: 0.4rem; background: #fff;
    border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow);
  }
  .lang ul a { display: block; padding: 0.45rem 0.75rem; border-radius: 8px; color: var(--text); text-decoration: none; }
  .lang ul a:hover { background: var(--sky); }
  .lang ul a[aria-current='true'] { font-weight: 700; color: var(--blue); }

  .quote { padding: 0.6rem 1.15rem; font-size: 0.95rem; }

  .menu-toggle {
    display: none; margin-left: auto; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.8rem; border: 1px solid var(--line); border-radius: 999px;
    background: #fff; color: var(--navy); font: inherit; font-weight: 600; cursor: pointer;
  }
  .menu-icon, .menu-icon::before, .menu-icon::after {
    display: block; width: 18px; height: 2px; background: currentColor; border-radius: 2px; position: relative;
  }
  .menu-icon::before, .menu-icon::after { content: ''; position: absolute; left: 0; }
  .menu-icon::before { top: -6px; }
  .menu-icon::after { top: 6px; }

  @media (max-width: 960px) {
    .menu-toggle { display: inline-flex; }
    .nav-panel {
      display: none; position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; align-items: stretch; gap: 1rem;
      padding: 1rem 1.25rem 1.5rem; background: #fff; border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .site-header.is-open .nav-panel { display: flex; }
    .nav-list { flex-direction: column; }
    .nav-list a[aria-current='page'] { box-shadow: inset 3px 0 0 var(--blue); }
    .lang ul { position: static; box-shadow: none; margin-top: 0.4rem; }
  }
</style>
