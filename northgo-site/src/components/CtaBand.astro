---
interface Props {
  title: string;
  text: string;
  href: string;
  label: string;
}

const { title, text, href, label } = Astro.props;
---

<section class="section">
  <div class="wrap">
    <div class="cta-band">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <a class="btn btn--primary" href={href}>{label}</a>
    </div>
  </div>
</section>
