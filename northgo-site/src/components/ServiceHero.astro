---
import Logo from './Logo.astro';
import { asset } from '../i18n/utils';

interface Props {
  title: string;
  lead: string;
  breadcrumbHome: string;
  breadcrumbServices: string;
  homeHref: string;
  servicesHref: string;
  quoteHref: string;
  quoteLabel: string;
  backgroundSrc?: string;
  backgroundAlt?: string;
}

const {
  title,
  lead,
  breadcrumbHome,
  breadcrumbServices,
  homeHref,
  servicesHref,
  quoteHref,
  quoteLabel,
  backgroundSrc,
  backgroundAlt = '',
} = Astro.props;

const hasBg = Boolean(backgroundSrc);
---

<section class:list={['service-hero', hasBg && 'service-hero--media']}>
  {hasBg && (
    <div class="service-hero__media" aria-hidden="true">
      <img
        class="service-hero__img"
        src={asset(backgroundSrc!)}
        alt={backgroundAlt}
        width="1920"
        height="1080"
        decoding="async"
        fetchpriority="high"
      />
      <div class="service-hero__veil"></div>
    </div>
  )}
  <div class="wrap service-hero__inner">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={homeHref}>{breadcrumbHome}</a>
      <span aria-hidden="true">/</span>
      <a href={servicesHref}>{breadcrumbServices}</a>
      <span aria-hidden="true">/</span>
      <span>{title}</span>
    </nav>
    {hasBg && (
      <div class="service-hero__brand">
        <Logo tone="light" />
      </div>
    )}
    <h1>{title}</h1>
    <p class="service-hero__lead">{lead}</p>
    <div class="btn-row">
      <a class="btn btn--primary" href={quoteHref}>{quoteLabel}</a>
    </div>
  </div>
</section>

<style>
  .service-hero {
    position: relative;
    overflow: hidden;
    color: #dbe5f3;
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%);
    padding: clamp(3rem, 8vw, 5rem) 0;
  }

  .service-hero--media {
    min-height: min(72vh, 38rem);
    display: flex;
    align-items: flex-end;
    padding: clamp(5.5rem, 14vw, 8.5rem) 0 clamp(3.5rem, 8vw, 5rem);
  }

  .service-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .service-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
    display: block;
    transform: scale(1.04);
    animation: hero-drift 18s ease-in-out alternate infinite;
  }

  .service-hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(8, 22, 42, 0.92) 0%, rgba(8, 22, 42, 0.72) 42%, rgba(8, 22, 42, 0.28) 78%, rgba(8, 22, 42, 0.45) 100%),
      linear-gradient(180deg, rgba(8, 22, 42, 0.55) 0%, transparent 35%, rgba(8, 22, 42, 0.7) 100%);
  }

  .service-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .service-hero__brand {
    margin: 0 0 1.35rem;
    opacity: 0;
    animation: hero-rise 0.7s ease 0.08s forwards;
  }

  .service-hero__brand :global(.logo) {
    height: 36px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
    opacity: 0;
    animation: hero-rise 0.65s ease forwards;
  }

  .breadcrumb a {
    color: #9fc0f5;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
    color: #fff;
  }

  h1 {
    color: #fff;
    max-width: 14ch;
    margin-bottom: 0.75rem;
    opacity: 0;
    animation: hero-rise 0.7s ease 0.12s forwards;
  }

  .service-hero__lead {
    max-width: 34rem;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    margin: 0 0 1.75rem;
    opacity: 0;
    animation: hero-rise 0.7s ease 0.2s forwards;
  }

  .btn-row {
    opacity: 0;
    animation: hero-rise 0.7s ease 0.28s forwards;
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(0.7rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes hero-drift {
    from { transform: scale(1.04) translate3d(0, 0, 0); }
    to { transform: scale(1.08) translate3d(-1.2%, 0, 0); }
  }

  @media (max-width: 720px) {
    .service-hero--media {
      min-height: min(78vh, 34rem);
      align-items: flex-end;
    }

    .service-hero__img {
      object-position: 70% center;
    }

    .service-hero__veil {
      background:
        linear-gradient(180deg, rgba(8, 22, 42, 0.55) 0%, rgba(8, 22, 42, 0.78) 45%, rgba(8, 22, 42, 0.92) 100%),
        linear-gradient(90deg, rgba(8, 22, 42, 0.75) 0%, rgba(8, 22, 42, 0.4) 100%);
    }

    h1 { max-width: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-hero__img,
    .breadcrumb,
    .service-hero__brand,
    h1,
    .service-hero__lead,
    .btn-row {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
