---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  primary: { href: string; label: string };
  secondary?: { href: string; label: string };
}

const { eyebrow, title, text, primary, secondary } = Astro.props;
---

<section class="hero">
  <svg class="routes" viewBox="0 0 600 400" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
    <g fill="none" stroke="#60a5fa" stroke-width="1.5" stroke-dasharray="4 6" opacity="0.55">
      <path d="M40 300 C 160 120, 360 100, 560 180" />
      <path d="M80 340 C 240 240, 420 260, 580 320" />
      <path d="M20 200 C 180 60, 380 40, 520 90" />
    </g>
    <g fill="#93c5fd">
      <circle cx="40" cy="300" r="5" /><circle cx="560" cy="180" r="5" />
      <circle cx="80" cy="340" r="4" /><circle cx="580" cy="320" r="4" />
      <circle cx="20" cy="200" r="4" /><circle cx="520" cy="90" r="5" />
    </g>
  </svg>
  <div class="wrap inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lead">{text}</p>
    <div class="btn-row">
      <a class="btn btn--primary" href={primary.href}>{primary.label}</a>
      {secondary && <a class="btn btn--ghost" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; color: #dbe5f3;
    background: radial-gradient(ellipse at 80% 20%, #1e3a8a 0%, transparent 55%), linear-gradient(135deg, #0b2545 0%, #13315c 100%);
    padding: clamp(4.5rem, 12vw, 8.5rem) 0 clamp(6rem, 12vw, 9rem);
  }
  .routes { position: absolute; right: -5%; top: 0; width: 65%; height: 100%; }
  .inner { position: relative; }
  .eyebrow { color: #93c5fd; }
  h1 { color: #fff; max-width: 16ch; font-size: clamp(2.4rem, 6.5vw, 4.25rem); }
  .lead { max-width: 40rem; font-size: clamp(1.05rem, 1.8vw, 1.25rem); margin-bottom: 2rem; }
  @media (max-width: 720px) { .routes { width: 120%; opacity: 0.4; } }
</style>
