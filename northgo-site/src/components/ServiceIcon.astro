}

const PATHS: Record<ServiceSlug, string> = {
  'freight-logistics': 'M3 17h18l-2 4H5l-2-4Zm2-2V9h6V5h4v4h4v6H5Zm2-4v2h2v-2H7Zm4 0v2h2v-2h-2Zm4 0v2h2v-2h-2Z',
  'project-logistics': 'M4 21V9l4-2V3h2v3l9-4v2l-9 4v13H8v-6H6v6H4Zm8 0v-9h8v9h-2v-4h-4v4h-2Z',
  'warehouse-logistics': 'M2 9 12 3l10 6v12h-3v-9H5v9H2V9Zm5 5h4v3H7v-3Zm6 0h4v3h-4v-3Zm-6 4h4v3H7v-3Zm6 0h4v3h-4v-3Z',
  'shipping-agency': 'M12 2a3 3 0 0 1 1 5.8V9h3v2h-3v8.9c2.8-.4 5-2.4 5.8-4.9H17l3-4 3 4h-2.1C19.9 19.4 16.3 22 12 22s-7.9-2.6-8.9-7H1l3-4 3 4H5.2c.8 2.5 3 4.5 5.8 4.9V11H8V9h3V7.8A3 3 0 0 1 12 2Zm0 2a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z',
};

const { slug } = Astro.props;
---

<span class="icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="26" height="26"><path fill="currentColor" d={PATHS[slug]} /></svg>
</span>

<style>
  .icon {
    display: inline-grid; place-items: center; width: 52px; height: 52px;
    border-radius: 14px; background: var(--sky); color: var(--blue);
  }
</style>
