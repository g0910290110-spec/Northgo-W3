---
import ServiceIcon from './ServiceIcon.astro';
import type { ServiceSlug } from '../i18n/utils';

interface Props {
  slug: ServiceSlug;
  href: string;
  name: string;
  summary: string;
  cta: string;
}

const { slug, href, name, summary, cta } = Astro.props;
---

<article class="card service-card">
  <ServiceIcon slug={slug} />
  <h3><a href={href}>{name}</a></h3>
  <p>{summary}</p>
  <span class="more" aria-hidden="true">{cta} →</span>
</article>

<style>
  .service-card { position: relative; display: flex; flex-direction: column; gap: 0.75rem; transition: transform 0.15s, box-shadow 0.15s; }
  .service-card:hover { transform: translateY(-3px); box-shadow: 0 16px 40px rgba(11, 37, 69, 0.14); }
  .service-card:focus-within { outline: 3px solid #93c5fd; outline-offset: 2px; }
  h3 { margin: 0.25rem 0 0; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:focus-visible { outline: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  p { flex: 1; }
  .more { color: var(--blue); font-weight: 600; }
  @media (prefers-reduced-motion: reduce) { .service-card { transition: none; } .service-card:hover { transform: none; } }
</style>
