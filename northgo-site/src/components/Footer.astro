---
import Logo from './Logo.astro';
import { localePath, useT, SERVICE_SLUGS, LEGAL_SLUGS, type Lang } from '../i18n/utils';
import { OFFICES, telHref } from '../data/offices';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const link = (p: string) => localePath(lang, p);
const hq = OFFICES.find((o) => o.hq)!;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="about">
      <Logo tone="light" />
      <p>{t.footer.blurb}</p>
    </div>

    <nav aria-label={t.nav.services}>
      <h2>{t.nav.services}</h2>
      <ul>
        {SERVICE_SLUGS.map((s) => <li><a href={link(`/services/${s}`)}>{t.services[s].name}</a></li>)}
      </ul>
    </nav>

    <nav aria-label={t.footer.company}>
      <h2>{t.footer.company}</h2>
      <ul>
        <li><a href={link('/about')}>{t.nav.about}</a></li>
        <li><a href={link('/news')}>{t.nav.news}</a></li>
        <li><a href={link('/contact')}>{t.nav.contact}</a></li>
        <li><a href={link('/contact#quote')}>{t.nav.quote}</a></li>
        {import.meta.env.DEV && <li><a href="/admin/">後台</a></li>}
      </ul>
    </nav>

    <address>
      <h2>{t.footer.headOffice}</h2>
      <p>{hq.address}</p>
      <p><a href={telHref(hq.tel)}>{hq.tel}</a><br /><a href={`mailto:${hq.email}`}>{hq.email}</a></p>
    </address>
  </div>

  <div class="wrap legal">
    <p>© {year} Northgo Inc. {t.footer.rights}</p>
    <ul>
      {LEGAL_SLUGS.map((s) => <li><a href={link(`/legal/${s}`)}>{t.legal.titles[s]}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy); color: #b8c6da; padding: 4rem 0 1.5rem; font-size: 0.95rem; }
  .cols { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.4fr; gap: 2rem; }
  .about p { margin-top: 1rem; max-width: 22rem; }
  h2 { color: #fff; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  a { color: #dbe5f3; text-decoration: none; }
  a:hover { color: #fff; text-decoration: underline; }
  address { font-style: normal; }
  .legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem;
    margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgba(255, 255, 255, 0.12); font-size: 0.85rem;
  }
  .legal p { margin: 0; }
  .legal ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .cols { grid-template-columns: 1fr; } }
</style>
