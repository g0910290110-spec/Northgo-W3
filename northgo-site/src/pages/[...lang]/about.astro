---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getLang, langPaths, localePath, useT } from '../../i18n/utils';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const a = t.about;
const link = (p: string) => localePath(lang, p);
---

<Base lang={lang} path="/about" title={a.metaTitle} description={a.metaDesc}>
  <section class="page-head">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href={link('/')}>{t.nav.home}</a> / {t.nav.about}</nav>
      <h1>{a.title}</h1>
      <p>{a.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid--2">
      <div class="card statement">
        <p class="eyebrow">{a.visionLabel}</p>
        <p class="big">{a.vision}</p>
      </div>
      <div class="card statement">
        <p class="eyebrow">{a.missionLabel}</p>
        <p class="big">{a.mission}</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section__head">
        <h2>{a.timelineTitle}</h2>
      </div>
      <ol class="timeline">
        {a.timeline.map((item) => (
          <li>
            <span class="year">{item.year}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="grid grid--2 change">
        <div class="card">
          <h3>{a.changedTitle}</h3>
          <p>{a.changedText}</p>
        </div>
        <div class="card">
          <h3>{a.sameTitle}</h3>
          <p>{a.sameText}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2>{a.valuesTitle}</h2>
        <p>{a.valuesIntro}</p>
      </div>
      <div class="grid grid--4">
        {a.values.map((v) => (
          <div class="card">
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title={t.home.ctaTitle} text={t.home.ctaText} href={link('/contact#quote')} label={t.nav.quote} />
</Base>

<style>
  .statement { padding: 2rem; }
  .statement .eyebrow { margin-bottom: 0.5rem; }
  .big { font-size: clamp(1.3rem, 2.4vw, 1.65rem); font-weight: 700; color: var(--navy); line-height: 1.35; margin: 0; }

  .timeline { list-style: none; margin: 0 0 3rem; padding: 0; position: relative; }
  .timeline { --year-w: 6rem; }
  .timeline::before { content: ''; position: absolute; left: calc(var(--year-w) + 1rem); top: 0.5rem; bottom: 0.5rem; width: 2px; background: #cbd5e1; }
  .timeline li { display: grid; grid-template-columns: var(--year-w) 1fr; gap: 2rem; padding: 0 0 2rem; position: relative; }
  .timeline li::before {
    content: ''; position: absolute; left: calc(var(--year-w) + 1rem - 7px); top: 0.45rem;
    width: 16px; height: 16px; border-radius: 50%; background: var(--blue); border: 3px solid var(--bg-alt);
  }
  .year { font-weight: 800; color: var(--blue); text-align: right; padding-right: 0.5rem; font-size: 1.05rem; }
  .timeline h3 { margin-bottom: 0.25rem; }
  .timeline p { color: var(--muted); margin: 0; max-width: 40rem; }
  @media (max-width: 560px) {
    .timeline::before { left: 0.45rem; }
    .timeline li { grid-template-columns: 1fr; gap: 0.25rem; padding-left: 2rem; }
    .timeline li::before { left: -0.05rem; }
    .year { text-align: left; }
  }
</style>
